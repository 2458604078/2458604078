{
  "name": "linguaflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LinguaFlow — immersive multilingual learning platform (EN / JA / KO)",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "vite": "^6.3.5"
  }
}
